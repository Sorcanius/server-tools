# Beispiel fuer /etc/server-tools/credentials/mqtt.env
# KEINE echten Zugangsdaten in dieses Repository eintragen.

# Bestehender Legacy-Pfad fuer die aktuelle Node-RED-Verarbeitung
MQTT_LEGACY_HOST="EDIT_ME"
MQTT_LEGACY_PORT="1883"
MQTT_LEGACY_USER="EDIT_ME"
MQTT_LEGACY_PASSWORD="EDIT_ME"

# Neues server-tools MQTT
MQTT_HOST="EDIT_ME"
MQTT_PORT="1883"
MQTT_USER="EDIT_ME"
MQTT_PASSWORD="EDIT_ME"

# Migrationsschalter
MQTT_LEGACY_ENABLED="true"
MQTT_NEW_ENABLED="true"
