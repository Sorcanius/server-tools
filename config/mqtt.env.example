# Example for /etc/server-tools/credentials/mqtt.env
# NEVER put real credentials into this repository.

# Existing/legacy MQTT path used during migration.
MQTT_LEGACY_HOST="EDIT_ME"
MQTT_LEGACY_PORT="1883"
MQTT_LEGACY_USER="EDIT_ME"
MQTT_LEGACY_PASSWORD="EDIT_ME"
MQTT_LEGACY_ENABLED="true"

# New server-tools MQTT path.
MQTT_HOST="EDIT_ME"
MQTT_PORT="1883"
MQTT_USER="EDIT_ME"
MQTT_PASSWORD="EDIT_ME"
MQTT_NEW_ENABLED="true"
